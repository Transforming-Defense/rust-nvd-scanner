# NVD API Key
# Request a free key at: https://nvd.nist.gov/developers/request-an-api-key
# With an API key you get 50 requests per 30 seconds (vs 5 without)
NVD_API_KEY=your-nvd-api-key-here

# Optional local CVE DB size override in bytes (default: 524288000 = 500MB)
# Use this only if sync/load reports the DB is too large for the default safety limit.
RUST_NVD_SCANNER_DB_MAX_SIZE_BYTES=

# AI provider selection for `analyze` command: claude or openai
AI_PROVIDER=claude

# Claude API Key (for vulnerability analysis with --ai-provider claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-claude-api-key-here

# Optional Claude model override
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API Key (for vulnerability analysis with --ai-provider openai)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# Optional OpenAI model override
OPENAI_MODEL=gpt-5.3-codex

# Optional OpenAI reasoning effort
# Valid values: none, minimal, low, medium, high, xhigh
OPENAI_REASONING_EFFORT=low
